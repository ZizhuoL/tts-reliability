# Track the research repository deliberately; new root folders need review.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/AGENTS.md
!/PROJECT_BRIEF.md
!/STATUS.md
!/requirements.txt
!/requirements.lock.txt
!/pytest.ini
!/src/
!/scripts/
!/tests/
!/configs/
!/docs/
!/results/

# Local environments, credentials, private notes, and downloaded assets.
.venv/
.cache/
__pycache__/
.pytest_cache/
*.py[cod]
.DS_Store
.env
.env.*
*.pem
*.key
/data/
/models/
/checkpoints/
/upstream/
/logs/
/notes/
*.wav
*.mp3
*.m4a
*.flac
*.pt
*.pth
*.safetensors
*.onnx
*.lock

# Results default to local-only. Keep compact, reviewable research evidence.
/results/**
!/results/**/
!/results/**/summary.json
!/results/**/metrics.csv
!/results/**/paired.csv
!/results/**/validation.json
!/results/**/wer_by_length.png
!/results/**/wer_by_length.pdf
!/results/starter-provenance.json
!/results/training_implementation_comparison.json
!/results/generation_checks.json
!/results/repeated_generation_checks.json
!/results/final-protocol-v1/*.json
!/results/final-evaluation-v1/protocol.json
!/results/final-evaluation-v1/comparison-roles.json
!/results/final-evaluation-v1/completion.json
!/results/final-evaluation-v1/runs/*/raw.jsonl
!/results/final-evaluation-v1/runs/*/manifest.json
!/results/final-evaluation-v1/runs/*/runtime.json
!/results/final-evaluation-v1/failures/*/bootstrap.json
!/results/final-evaluation-v1/resources/report.md
!/results/analysis/B-final-exposure.json
!/results/analysis/B184-final-exposure.json
!/results/analysis/B-recovery-costs.json
!/results/analysis/development-selection.json
!/results/analysis/development-execution-reconciliation/incident.json
!/results/analysis/final-independent-audit.json
!/results/analysis/final-artifact-review.json
!/results/analysis/final-root-integrity-audit.json
!/results/analysis/reproduction-input-audit.json
!/results/analysis/*final-training-plots*/*.png
!/results/analysis/*final-training-plots*/*.pdf

# Repeated snapshots, bulky plot inputs, and personal voice experiments stay local.
/results/**/inputs/
/results/**/__pycache__/
/results/personalized*/
/results/listening/
/results/final-evaluation-v1/listening/
/scripts/*personalized*

# Export path-redacted metadata; preserve original hash-bound files locally.
/results/analysis/B-final-exposure.json
/results/analysis/B184-final-exposure.json
/results/analysis/final-artifact-review.json
/results/final-evaluation-v1/runs/A/manifest.json
/results/final-evaluation-v1/runs/ANoLM/manifest.json
/results/final-evaluation-v1/runs/ASplit/manifest.json
/results/final-evaluation-v1/runs/B/manifest.json
/results/final-evaluation-v1/runs/B184/manifest.json
/results/final-evaluation-v1/runs/B184NoLM/manifest.json
/results/final-evaluation-v1/runs/B184Split/manifest.json
/results/final-evaluation-v1/runs/BNoLM/manifest.json
/results/final-evaluation-v1/runs/BSplit/manifest.json
/results/generation_checks.json
!/results/repository-evidence/**
